# Cloudflare R2 (S3 API) — the bucket that holds content/ (see CONTENT.md)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
# Folder inside the bucket (default: film-files)
R2_PREFIX=film-files

# Public address of the bucket, for images. Use a custom domain in production
# (r2.dev addresses are rate-limited by Cloudflare).
NEXT_PUBLIC_R2_PUBLIC_URL=

# The live site, for canonical URLs/sitemap, and for content:push to refresh it
NEXT_PUBLIC_SITE_URL=https://example.com
# Any long random string; set the same value on the host
REVALIDATE_SECRET=

# Optional: force where content is read from (r2 | local). Default: r2 when configured.
# CONTENT_SOURCE=local
